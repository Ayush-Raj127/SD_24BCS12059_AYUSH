        </mxCell>
        <mxCell id="lb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7DB1;strokeWidth=2;fontColor=#20304A;fontSize=12;fontStyle=1;" value="Load Balancer" vertex="1">
