        <mxCell id="a11" edge="1" parent="1" source="app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4E9D68;strokeWidth=2;endArrow=block;" target="client" value="redirect to long URL">
