<mxfile host="app.diagrams.net">
  <diagram id="tinyurl" name="TinyURL System Design">
    <mxGraphModel dx="1373" dy="765" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78C2;strokeWidth=2;fontColor=#16345C;fontStyle=1;fontSize=22;" value="TinyURL — Simple System Design" vertex="1">
          <mxGeometry height="55" width="1270" x="30" y="20" as="geometry" />
        </mxCell>
        <mxCell id="fhead" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C7E6;strokeWidth=2;fontColor=#20304A;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=10;" value="Functional Requirements" vertex="1">
          <mxGeometry height="220" width="390" x="30" y="95" as="geometry" />
        </mxCell>
        <mxCell id="f" parent="fhead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FBFF;strokeColor=#78A9E6;strokeWidth=2;fontColor=#20304A;fontSize=12;align=left;verticalAlign=top;spacing=10;" value="• Convert long URL → short URL&lt;br&gt;• Redirect short URL → original URL&lt;br&gt;• Generate unique short codes&lt;br&gt;• Allow users to create/view their URLs&lt;br&gt;• Basic click analytics (optional)" vertex="1">
          <mxGeometry height="165" width="360" x="15" y="40" as="geometry" />
        </mxCell>
        <mxCell id="nhead" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C7E6;strokeWidth=2;fontColor=#20304A;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=10;" value="Non-Functional Requirements" vertex="1">
          <mxGeometry height="220" width="390" x="440" y="95" as="geometry" />
        </mxCell>
        <mxCell id="n" parent="nhead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF2;strokeColor=#E5C45B;strokeWidth=2;fontColor=#403817;fontSize=12;align=left;verticalAlign=top;spacing=10;" value="• High availability&lt;br&gt;• Low latency&lt;br&gt;• Horizontally scalable&lt;br&gt;• Reliable URL storage&lt;br&gt;• Unique short URLs&lt;br&gt;• Analytics can be asynchronous" vertex="1">
          <mxGeometry height="165" width="360" x="15" y="40" as="geometry" />
        </mxCell>
        <mxCell id="ehead" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C7E6;strokeWidth=2;fontColor=#20304A;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=10;" value="Back-of-the-Envelope Estimation" vertex="1">
          <mxGeometry height="220" width="450" x="850" y="95" as="geometry" />
        </mxCell>
        <mxCell id="e" parent="ehead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FCF7;strokeColor=#70B887;strokeWidth=2;fontColor=#214B2D;fontSize=12;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;Traffic&lt;/b&gt;&lt;br&gt;10M users/day&lt;br&gt;2 short URLs/user/day → 20M writes/day&lt;br&gt;10 redirects/user/day → 100M reads/day&lt;br&gt;&lt;br&gt;&lt;b&gt;Short code&lt;/b&gt;&lt;br&gt;Base62, 7 characters → 62⁷ ≈ 3.5 trillion combinations&lt;br&gt;&lt;br&gt;&lt;b&gt;Storage&lt;/b&gt;&lt;br&gt;~200 bytes/long URL → ~4 GB/day → ~1.5 TB/year" vertex="1">
          <mxGeometry height="165" width="420" x="15" y="40" as="geometry" />
        </mxCell>
        <mxCell id="ahead" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#8EA4C6;strokeWidth=2;fontColor=#233552;fontStyle=1;fontSize=18;verticalAlign=top;spacingTop=12;" value="Architecture" vertex="1">
