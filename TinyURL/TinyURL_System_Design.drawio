        <mxCell id="a12" edge="1" parent="1" source="app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C49A2C;strokeWidth=2;dashed=1;endArrow=block;" target="analytics" value="click data">
