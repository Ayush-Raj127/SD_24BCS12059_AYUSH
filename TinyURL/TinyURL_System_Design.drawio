        <mxCell id="a1" edge="1" parent="1" source="client" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A78C2;strokeWidth=2;endArrow=block;" target="lb" value="Create / Shorten">
