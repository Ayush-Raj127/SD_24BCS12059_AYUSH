        <mxCell id="section" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;align=center" value="System Requirements &amp; Estimation" vertex="1">
          <mxGeometry height="40" width="800" x="402.5" y="510" as="geometry" />
        </mxCell>
        <mxCell id="fr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;spacing=12" value="&lt;b&gt;Functional Requirements&lt;/b&gt;&lt;br&gt;• User signup and login&lt;br&gt;• Browse movies and TV shows&lt;br&gt;• Search for content&lt;br&gt;• Play, pause and resume videos&lt;br&gt;• Continue Watching&lt;br&gt;• Multiple user profiles&lt;br&gt;• Personalized recommendations&lt;br&gt;• Watch history and playback progress" vertex="1">
          <mxGeometry height="270" width="470" x="50" y="555" as="geometry" />
        </mxCell>
        <mxCell id="nfr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;spacing=12" value="&lt;b&gt;Non-Functional Requirements&lt;/b&gt;&lt;br&gt;• High availability&lt;br&gt;• Low video startup latency&lt;br&gt;• Horizontal scalability&lt;br&gt;• Fault tolerance&lt;br&gt;• Smooth video streaming&lt;br&gt;• Secure accounts and payments&lt;br&gt;• Global availability&lt;br&gt;• Eventual consistency for recommendations" vertex="1">
          <mxGeometry height="270" width="470" x="565" y="555" as="geometry" />
        </mxCell>
        <mxCell id="boe" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacing=12" value="&lt;b&gt;Back-of-the-Envelope Estimation&lt;/b&gt;&lt;br&gt;• 100M DAU&lt;br&gt;• 2 hours viewing/user/day&lt;br&gt;• 200M viewing hours/day&lt;br&gt;• Average concurrency ≈ 8.3M viewers&lt;br&gt;• Peak concurrency ≈ 16.6M viewers (2× average)&lt;br&gt;• Average bitrate ≈ 5 Mbps/viewer&lt;br&gt;• Peak bandwidth ≈ 83 Tbps&lt;br&gt;• 20,000 titles × 10 GB ≈ 200 TB&lt;br&gt;• 5 quality/resolution versions ≈ 1 PB storage&lt;br&gt;• Video traffic is handled by the CDN" vertex="1">
          <mxGeometry height="270" width="470" x="1080" y="555" as="geometry" />
        </mxCell>
