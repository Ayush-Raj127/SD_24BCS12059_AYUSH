<diagram id="netflix-simple-fixed" name="Netflix Simple System Design">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="950" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="Netflix — Simple System Design" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78C2;strokeWidth=2;fontColor=#16345C;fontStyle=1;fontSize=22;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1270" height="55" as="geometry"/></mxCell><mxCell id="fhead" value="Functional Requirements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB3D1;strokeWidth=2;fontColor=#20304A;fontStyle=1;fontSize=15;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="390" height="225" as="geometry"/></mxCell><mxCell id="f" value="• User sign up / login&lt;br&gt;• Browse movies and TV shows&lt;br&gt;• Search for content&lt;br&gt;• Play / pause / resume videos&lt;br&gt;• Continue watching from last position&lt;br&gt;• Show recommendations&lt;br&gt;• Store watch history and profiles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FBFF;strokeColor=#78A9E6;strokeWidth=2;fontColor=#20304A;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="45" y="135" width="360" height="165" as="geometry"/></mxCell><mxCell id="nhead" value="Non-Functional Requirements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB3D1;strokeWidth=2;fontColor=#20304A;fontStyle=1;fontSize=15;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="440" y="95" width="390" height="225" as="geometry"/></mxCell><mxCell id="n" value="• High availability&lt;br&gt;• Low playback/startup latency&lt;br&gt;• Horizontally scalable&lt;br&gt;• Fault tolerant&lt;br&gt;• Smooth streaming with minimal buffering&lt;br&gt;• Secure accounts and payments&lt;br&gt;• Globally available content" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF2;strokeColor=#DDBA42;strokeWidth=2;fontColor=#403817;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="455" y="135" width="360" height="165" as="geometry"/></mxCell><mxCell id="ehead" value="Back-of-the-Envelope Estimation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB3D1;strokeWidth=2;fontColor=#20304A;fontStyle=1;fontSize=15;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="850" y="95" width="450" height="225" as="geometry"/></mxCell><mxCell id="est" value="&lt;b&gt;Assumptions&lt;/b&gt;&lt;br&gt;100M daily active viewers&lt;br&gt;Average 2 hours watched/user/day&lt;br&gt;≈ 200M viewing hours/day&lt;br&gt;&lt;br&gt;&lt;b&gt;Traffic&lt;/b&gt;&lt;br&gt;≈ 500K concurrent viewers average&lt;br&gt;Peak ≈ 2× → ~1M concurrent streams&lt;br&gt;&lt;br&gt;&lt;b&gt;Storage&lt;/b&gt;&lt;br&gt;Video is stored in multiple quality versions and served through a CDN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FCF7;strokeColor=#70B887;strokeWidth=2;fontColor=#214B2D;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="865" y="135" width="420" height="165" as="geometry"/></mxCell><mxCell id="arch" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8EA4C6;strokeWidth=2;fontColor=#233552;fontStyle=1;fontSize=18;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="1270" height="515" as="geometry"/></mxCell><mxCell id="user" value="User / TV / Mobile / Browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7DB1;strokeWidth=2;fontColor=#20304A;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="555" width="180" height="60" as="geometry"/></mxCell><mxCell id="lb" value="Load Balancer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7DB1;strokeWidth=2;fontColor=#20304A;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="555" width="150" height="60" as="geometry"/></mxCell><mxCell id="app" value="Netflix Application Server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7DB1;strokeWidth=2;fontColor=#20304A;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="515" y="535" width="195" height="95" as="geometry"/></mxCell><mxCell id="db" value="Database&lt;br&gt;User + Watch History" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D7AE3D;strokeWidth=2;fontColor=#4A3A12;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="560" width="185" height="75" as="geometry"/></mxCell><mxCell id="cache" value="Cache&lt;br&gt;Popular / User Data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF8EF;strokeColor=#59A873;strokeWidth=2;fontColor=#214B2D;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="440" width="185" height="65" as="geometry"/></mxCell><mxCell id="cdn" value="CDN&lt;br&gt;Video Content" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7DB1;strokeWidth=2;fontColor=#20304A;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1035" y="440" width="185" height="65" as="geometry"/></mxCell><mxCell id="content" value="Content Storage&lt;br&gt;Movies / Shows" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D7AE3D;strokeWidth=2;fontColor=#4A3A12;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1035" y="560" width="185" height="75" as="geometry"/></mxCell><mxCell id="rec" value="Recommendation Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7DB1;strokeWidth=2;fontColor=#20304A;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="515" y="700" width="195" height="65" as="geometry"/></mxCell><mxCell id="a1" value="requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A78C2;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="user" target="lb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" value="forward" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A78C2;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="lb" target="app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a3" value="user data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A78C2;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="app" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a4" value="fast lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4E9D68;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="app" target="cache"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a5" value="recommendations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A78C2;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="app" target="rec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a6" value="video request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4E9D68;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="user" target="cdn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a7" value="video files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4E9D68;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="cdn" target="content"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a8" value="play video" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4E9D68;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="cdn" target="user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a9" value="save progress" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C49A2C;strokeWidth=2;dashed=1;endArrow=block;" edge="1" parent="1" source="app" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Simple idea:&lt;/b&gt; The application server handles login, browsing, search and user data. The database stores profiles and watch history. Cache makes common data faster. Large video files are stored separately and delivered through a CDN, so the application server does not send the video itself." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB3D1;strokeWidth=2;fontColor=#20304A;fontStyle=1;fontSize=15;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="70" y="770" width="1120" height="65" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
